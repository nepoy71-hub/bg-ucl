"; bg_gameplay.ini -- настройки на bg_gameplay.dll (PES 2021, exe 1.01)\r\n"
"; Чете се при пускане на играта и наново преди всеки мач: промяната важи от следващия мач.\r\n"
"; Всяка стойност може да е konami (= както в играта, без промяна).\r\n"
"; Ако файлът липсва, DLL-ът го създава с тези стойности.\r\n"
"\r\n"
"[defense]\r\n"
"def_pursuit_speed = 36      ; Скорост на преследване на защитниците на AI (най-бързото им ниво на движение).\r\n"
"                            ; Konami 28. При 6 защитата почти не те гони; при 36 натиска по целия терен.\r\n"
"\r\n"
"profile = fair              ; <<< ТУК СМЕНЯШ ПРОФИЛА. Напиши една от четирите думи:\r\n"
"                            ;     light  = лека корекция: защитникът остава най-бърз и „надзърта“ най-много\r\n"
"                            ;              (най-трудно за теб от трите)\r\n"
"                            ;     fair   = по средата (по подразбиране)\r\n"
"                            ;     strong = силна корекция: защитникът реагира най-бавно, като човек\r\n"
"                            ;              (най-лесно за теб от трите)\r\n"
"                            ;     custom = твои стойности от секцията [profile_custom] по-долу\r\n"
"                            ; Пример: profile = strong\r\n"
"                            ; Числата на всеки профил са в неговата секция отдолу – можеш да ги променяш.\r\n"
"                            ; Важи само секцията на избрания профил; другите се пренебрегват.\r\n"
"\r\n"
"; ------------------------------------------------------------------------------------------------\r\n"
"; Какво значат петте числа (еднакви във всеки профил):\r\n"
";   decide – каква част от твоето докосване (0..1) трябва да е минала, преди защитникът да „прочете“\r\n"
";            новата ти посока от стика, когато решава дали и къде да отнеме / шпагат.\r\n"
";            0 = ясновидец, 1 = вижда само реалната топка. Konami 0.7 (+ два случая без проверка).\r\n"
";   foot   – същото за посоката на крака по време на отнемането. Konami почти винаги 0.\r\n"
";   angle  – същото за ъгъла на тялото ти, по който AI избира отнемането (0..0.99). Konami 0.5.\r\n"
";   press  – същото за посоката, в която пресата смята, че тръгваш. Konami 0.25.\r\n"
";   react  – на колко кадъра (54 в секунда) защитникът срещу теб (1 срещу 1 и задържане) решава наново\r\n"
";            къде да застане. Konami 1-2; 8 = до 130 ms; човек ~200-250 ms (11-14).\r\n"
"; По-големи числа = защитникът „надзърта“ по-малко и реагира по-бавно = по-лесно за теб.\r\n"
"; ------------------------------------------------------------------------------------------------\r\n"
"\r\n"
"[profile_light]\r\n"
"decide = 0.8\r\n"
"foot = 0.8\r\n"
"angle = 0.7\r\n"
"press = 0.4\r\n"
"react = 4\r\n"
"\r\n"
"[profile_fair]\r\n"
"decide = 0.85\r\n"
"foot = 0.85\r\n"
"angle = 0.8\r\n"
"press = 0.6\r\n"
"react = 8\r\n"
"\r\n"
"[profile_strong]\r\n"
"decide = 1\r\n"
"foot = 1\r\n"
"angle = 0.95\r\n"
"press = 0.9\r\n"
"react = 12\r\n"
"\r\n"
"[profile_custom]            ; ползва се само при profile = custom\r\n"
"decide = 0.85\r\n"
"foot = 0.85\r\n"
"angle = 0.8\r\n"
"press = 0.6\r\n"
"react = 8\r\n"
"\r\n"
"[press]\r\n"
"; Кой защитник на AI тръгва да НАТИСКА топконосителя. Важи само когато AI е на Professional или по-високо ниво.\r\n"
"; Разстоянията са в метри от защитника до топконосителя; по-голямо = натиска от по-далеч. Защитникът трябва да е\r\n"
"; между топконосителя и своята врата. Специалните случаи (гонене на резултат, Gegenpress, Tight Marking, дерби,\r\n"
"; атакуващ режим, Legend) остават както в играта – там натискът и без това е от по-далеч.\r\n"
"press_radius_normal = 9     ; ОСНОВНИЯТ радиус в обикновена игра. Защитникът тръгва на натиск, само ако е по-близо.\r\n"
"                            ; Konami 6. Главният регулатор за „натиск по целия терен“.\r\n"
"press_radius_far = 12       ; ДАЛЕЧНИЯТ радиус в обикновена игра – горна граница преди основния. Konami 10.\r\n"
"                            ; Трябва да е поне колкото press_radius_normal, иначе той реже основния.\r\n"
"                            ; В играта същото число е и добавката за бърз защитник на ниво Legend (+10 м).\r\n"
"sandwich_distance = 2.0     ; На колко метра от теб застава вторият защитник при сандвич (двоен натиск).\r\n"
"                            ; Konami 1.5. По-малко = по-плътно (повече сблъсъци); по-голямо = оставя място да излезеш.\r\n"
"\r\n"
"[slides]\r\n"
"slide = fix                 ; fix = маха засилването на шпагатите, когато AI губи (+1 „гони резултата“ и +1\r\n"
"                            ; „атака ниво 4“ към агресията на шпагата). konami = засилването остава.\r\n"
"slidemax = 2                ; Таван на агресията на шпагата L (0..3). Konami 3. L решава от колко далеч\r\n"
"                            ; (4 + 0.8*L м), колко неточен ъгъл / момент и колко риск от сблъсък приема шпагатът;\r\n"
"                            ; при 3 пропуска проверката „друг противник наблизо“. Под 3 AI не влиза с шпагат в\r\n"
"                            ; своето наказателно поле.\r\n"
"\r\n"
"[injury]\r\n"
"injury_single_hit = 110     ; Колко силен трябва да е ЕДИН удар, за да контузи играч веднага (без натрупване до 200).\r\n"
"                            ; Важи, когато ударът го събори в половината на противника и после се свири фал.\r\n"
"                            ; Konami 85: шпагат отзад на висока скорост (~100-125) често го надминава.\r\n"
"                            ; 110 = контузва само наистина брутален удар. Натрупването (150 риск / 200 контузия)\r\n"
"                            ; не се променя. Важи и за двата отбора.\r\n"
"\r\n"
"[ballcarrier]\r\n"
"attack_finish_angle = 85    ; Кога ТОПКОНОСИТЕЛЯТ НА AI минава в режим „довършване“: стреля / рискува, вместо да\r\n"
"                            ; подава напред. Минава, ако гледа към вратата под ъгъл, по-малък от това число,\r\n"
"                            ; и има свободен коридор. Konami 100. По-малко = по-малко прибързани удари и симулации,\r\n"
"                            ; по-търпеливо изграждане.\r\n"
"\r\n"
"[debug]\r\n"
"collision_log = 0           ; 1 = записва всеки сблъсък с щета в bg_gameplay_collisions.log (до DLL-а): време,\r\n"
"                            ; кой кого, действията и скоростите им, щета по формулата и записана щета, натрупана\r\n"
"                            ; щета, „кандидат за контузия“, чакащ фал. Само чете. 0 = изключен.\r\n"
"\r\n"
"; Съдията е с фиксирани прагове (без настройка): фал извън полето 38, в полето 35, жълт 70, червен 105\r\n"
"; (Konami 40 / 60 / 80 / 110).\r\n"
"\r\n"
